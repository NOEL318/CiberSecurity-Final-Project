<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/svLog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Settings -->
        <LinearLayout style="@style/Card" android:layout_marginTop="16dp">

            <LinearLayout style="@style/CardHeader">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/circle_ecc"
                    android:padding="6dp"
                    android:src="@drawable/ic_chart"
                    android:tint="#FFFFFF" />
                <TextView style="@style/CardTitle" android:text="RSA vs ECC at the receiver" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDevice"
                style="@style/Hint"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Label" android:text="Message length (chars)" />
                    <EditText android:id="@+id/etLen" style="@style/Input" android:inputType="number" android:text="140" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/Label" android:text="Iterations" />
                    <EditText android:id="@+id/etIters" style="@style/Input" android:inputType="number" android:text="50" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnRunKeys"
                style="@style/BtnPrimary"
                android:layout_marginTop="14dp"
                android:drawableStart="@drawable/ic_play"
                android:text="Run key-size test" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRunSweep"
                    style="@style/BtnSecondary"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Length sweep" />

                <Button
                    android:id="@+id/btnShare"
                    style="@style/BtnSecondary"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_share"
                    android:text="Share CSV" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/pbBench"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Results -->
        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/CardHeader">
                <TextView style="@style/CardTitle" android:text="Results" />
                <TextView
                    style="@style/Chip"
                    android:background="@drawable/chip_rsa"
                    android:text="RSA"
                    android:textColor="@color/rsa" />
                <TextView
                    style="@style/Chip"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/chip_ecc"
                    android:text="ECC"
                    android:textColor="@color/ecc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Hint"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Run a test to compare key generation, encryption and decryption times. Bars show decryption time (the receiver's cost)." />
            </LinearLayout>
        </LinearLayout>

        <!-- Raw log -->
        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/CardHeader" android:layout_marginBottom="0dp">
                <TextView style="@style/CardTitle" android:text="Raw log and CSV" />
                <Button
                    android:id="@+id/btnToggleLog"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_secondary"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null"
                    android:text="Show"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLog"
                style="@style/Mono"
                android:layout_marginTop="12dp"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
